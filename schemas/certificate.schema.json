{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.org/sabi/certificate.schema.json",
  "title": "SABI Portability Certificate",
  "description": "Unsigned or signed attestation carrying an explicit evidence class. A static-only result can never claim a runtime class.",
  "type": "object",
  "required": [
    "skill",
    "skill_digest",
    "abi_digest",
    "sabi",
    "cases",
    "passed",
    "failed",
    "evidence_class",
    "signed"
  ],
  "properties": {
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "skill_digest": {
      "type": "string",
      "pattern": "^sha256:"
    },
    "abi_digest": {
      "type": "string",
      "pattern": "^sha256:"
    },
    "lock_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:"
        }
      ]
    },
    "sabi": {
      "type": "string",
      "pattern": "^sabi/v"
    },
    "tested_runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "runtime",
          "tier"
        ],
        "properties": {
          "runtime": {
            "type": "string"
          },
          "tier": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "tested_tiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "type": "integer",
      "minimum": 0
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "effect_violations": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "SPEC_VALID",
        "STATIC_CONFORMANT",
        "RUNTIME_TESTED",
        "MULTI_RUNTIME_TESTED",
        "ATTESTED"
      ]
    },
    "run_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "runtime",
          "harness",
          "evidence"
        ],
        "properties": {
          "runtime": {
            "type": "string",
            "minLength": 1
          },
          "harness": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "signed": {
      "type": "boolean"
    },
    "signature": {
      "type": "object",
      "required": [
        "alg",
        "attestor",
        "value"
      ],
      "properties": {
        "alg": {
          "type": "string"
        },
        "attestor": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "bundle": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
