{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sabi.dev/schemas/skill-abi.schema.json",
  "title": "SABI Skill ABI Contract",
  "description": "Machine-verifiable contract for a portable agent skill (SABI v0.1).",
  "type": "object",
  "required": [
    "spec",
    "version",
    "capabilities"
  ],
  "properties": {
    "spec": {
      "type": "string",
      "pattern": "^sabi/v"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "conformance": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3",
            "P4",
            "P4M",
            "P5"
          ]
        },
        "spec_version": {
          "type": "string"
        },
        "evidence_ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
